{
  "hosting": {
    "site": "libbssimulador",
    "public": "web",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "/api/config",
        "destination": "/api/config.json"
      },
      {
        "source": "/api/catalog",
        "destination": "/api/catalog.json"
      },
      {
        "source": "/api/bootstrap",
        "destination": "/api/bootstrap.json"
      },
      {
        "source": "/api/version",
        "destination": "/api/version.json"
      },
      {
        "source": "/api/keys",
        "destination": "/api/keys.json"
      },
      {
        "source": "/api/users",
        "destination": "/api/users.json"
      },
      {
        "source": "/api/catalog/status",
        "destination": "/api/catalog/status.json"
      },
      {
        "source": "/api/key/status",
        "destination": "/api/key/status.json"
      },
      {
        "source": "/api/me",
        "destination": "/api/me.json"
      },
      {
        "source": "**",
        "destination": "/index.html"
      }
    ],
    "headers": [
      {
        "source": "**/*.@(js|css|json)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "max-age=0, must-revalidate"
          }
        ]
      }
    ]
  }
}
